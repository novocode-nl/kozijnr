# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://api.kozijnr.localhost
###< symfony/routing ###

###> app/tenancy ###
# Base domain requests are matched against to detect a tenant/admin/api
# subdomain (see App\Tenancy\Domain\Subdomain and README.md "Local domains
# via nginx"). A request to this host itself (or to any host that doesn't end
# in ".<this value>") stays on the public schema. Override in production with
# the real apex domain, e.g. APP_BASE_DOMAIN=kozijnr.nl.
#
# Locally "kozijnr.localhost" for the main checkout (matched by
# docker-compose.yml's own default). Every worktree overrides this in its own
# generated root .env (scripts/setup-worktree-env.sh) to
# "koz-<n>.kozijnr.localhost", which docker-compose passes into the container
# as a real env var, taking precedence over this file's value.
APP_BASE_DOMAIN=kozijnr.localhost
###< app/tenancy ###

###> app/storage (KOZ-32) ###
# Which Flysystem adapter FileStorageInterface is backed by — see
# App\Shared\Infrastructure\Storage\FlysystemAdapterFactory and
# config/services.yaml. "local" (default) writes into
# APP_STORAGE_LOCAL_ROOT, a path relative to the project root that lives
# inside the existing ./api:/app dev mount, so uploaded files survive
# container restarts without any extra Docker service.
#
# Switch to "s3" for a production S3-compatible bucket (e.g. DigitalOcean
# Spaces) — no adapter code changes, only these env vars:
#   APP_STORAGE_ADAPTER=s3
#   APP_STORAGE_S3_BUCKET=my-bucket
#   APP_STORAGE_S3_REGION=ams3
#   APP_STORAGE_S3_ENDPOINT=https://ams3.digitaloceanspaces.com
#   APP_STORAGE_S3_KEY=...
#   APP_STORAGE_S3_SECRET=...
# (APP_STORAGE_S3_ENDPOINT is only needed for an S3-*compatible* provider;
# leave it unset to target real AWS S3.)
APP_STORAGE_ADAPTER=local
APP_STORAGE_LOCAL_ROOT=var/storage
APP_STORAGE_S3_BUCKET=
APP_STORAGE_S3_REGION=
APP_STORAGE_S3_ENDPOINT=
APP_STORAGE_S3_KEY=
APP_STORAGE_S3_SECRET=
###< app/storage (KOZ-32) ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###
