# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Pinned independently of api/.env's dev default ("kozijnr.localhost") — the
# test suite (TenantResolverListenerTest,
# AdminRouteGuardListenerTest, ...) hardcodes "localhost"-based hostnames
# and must not change behavior when the dev default changes.
APP_BASE_DOMAIN=localhost

# KOZ-32: keep test-suite file uploads out of the dev storage root — a
# separate directory under var/ so ProfilePhotoControllerTest etc. never
# leave files behind in var/storage.
APP_STORAGE_LOCAL_ROOT=var/storage_test
