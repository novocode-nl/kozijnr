# Example root .env for docker-compose. `make up` generates this automatically
# (scripts/setup-worktree-env.sh, see README.md "Per-worktree test
# environments"); copy by hand only if you want something non-standard.
#
# Main checkout:
#   COMPOSE_PROJECT_NAME=kozijnr
#   DATABASE_PORT=5432
#   APP_BASE_DOMAIN=kozijnr.localhost
#
# Worktree for KOZ-12 (the values below):
COMPOSE_PROJECT_NAME=koz-12
DATABASE_PORT=5444
APP_BASE_DOMAIN=koz-12.kozijnr.localhost
