# Example root .env for docker-compose. Copy to .env and adjust, or generate
# one automatically per worktree with `scripts/setup-worktree-env.sh <issue-number>`
# (see README.md, "Per-worktree test environments").
#
# Left unset / absent, docker-compose.yml falls back to the plain
# non-worktree defaults: project name "kozijnr", frontend 3000, backend 8000,
# database 5432, APP_BASE_DOMAIN kozijnr.test.
#
# APP_BASE_DOMAIN (KOZ-12) is the Valet base domain for this worktree — see
# README.md "Local domains via Laravel Valet". Optional: still works without
# Valet installed, via the port-based URLs below.

COMPOSE_PROJECT_NAME=koz-12
FRONTEND_PORT=3012
BACKEND_PORT=8012
DATABASE_PORT=5444
NEXT_PUBLIC_API_URL=http://localhost:8012
APP_BASE_DOMAIN=kozijnr-koz-12.test
